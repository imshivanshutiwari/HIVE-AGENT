class ClaudeClient:
  Anthropic claude-sonnet-4-6 with tool_use + streaming.

  methods:
    __init__():
      import anthropic
      self.client = anthropic.Anthropic(
          api_key=os.environ["ANTHROPIC_API_KEY"])
      self.model = "claude-sonnet-4-6"

    generate_with_tools(prompt: str,
                        tools: List[dict],
                        system: str = None) -> ToolUseResult
      response = self.client.messages.create(
          model=self.model,
          max_tokens=4096,
          tools=tools,
          messages=[{"role":"user","content":prompt}],
          system=system or DEFAULT_SYSTEM
      )
      Handle: tool_use blocks → call tool → continue
      Returns: final text response

    stream_generate(prompt: str) -> Iterator[str]
      with self.client.messages.stream(
          model=self.model,
          max_tokens=4096,
          messages=[{"role":"user","content":prompt}]
      ) as stream:
          for text in stream.text_stream:
              yield text

    track_usage(response) -> TokenUsage
      TokenUsage: {input_tokens, output_tokens,
                   cache_read_tokens, total_cost_usd}

