class DocumentationEvaluator:
  BERTScore + ROUGE evaluation.

  methods:
    compute_bertscore(generated: List[str],
                      reference: List[str]) -> dict
      bert_score.score(generated, reference,
                       lang='en',
                       model_type='microsoft/deberta-xlarge-mnli')
      Returns: {precision, recall, f1} per doc

    compute_rouge(generated: str,
                  reference: str) -> dict
      rouge_scorer.RougeScorer(['rouge1','rouge2','rougeL'])
