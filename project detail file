class PythonASTParser:
  Full Python AST analysis using stdlib ast module.

  methods:
    parse_file(filepath: str) -> ASTResult
      tree = ast.parse(open(filepath).read())
      ASTResult: {
        functions: List[FunctionInfo],
        classes: List[ClassInfo],
        imports: List[ImportInfo],
        globals: List[str],
        docstrings: Dict[str, str],
        type_hints: Dict[str, str]
      }

    extract_function_info(node: ast.FunctionDef) -> FunctionInfo
      FunctionInfo: {
        name, args, return_type, decorators,
        docstring, body_lines, calls_made,
        raises, yields, is_async,
        cyclomatic_complexity, cognitive_complexity
      }

    compute_cyclomatic_complexity(node) -> int
      Count: if/elif/else/for/while/try/except/
             with/assert/and/or/ternary
      M = E - N + 2P (McCabe formula)

    compute_cognitive_complexity(node) -> int
      SonarSource cognitive complexity algorithm:
      +1 for each nesting increment
      +nesting_level for nested structures

    extract_call_graph(tree) -> nx.DiGraph
      Edges: caller function → called function

